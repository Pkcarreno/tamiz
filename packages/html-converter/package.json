{
  "name": "@tamiz/html-converter",
  "version": "0.1.0",
  "description": "Isomorphic HTML-to-text converter toolkit for the Tamiz browser extension",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/converter.d.mts",
      "default": "./dist/converter.js"
    },
    "./dom": {
      "types": "./dist/dom.d.mts",
      "default": "./dist/dom.js"
    },
    "./cleaner": {
      "types": "./dist/cleaner.d.mts",
      "default": "./dist/cleaner.js"
    },
    "./strategies/html": {
      "types": "./dist/strategies/html.d.mts",
      "default": "./dist/strategies/html.js"
    },
    "./strategies/markdown": {
      "types": "./dist/strategies/markdown.d.mts",
      "default": "./dist/strategies/markdown.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf .turbo node_modules dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "linkedom": "^0.18.13",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
