{
  "$schema": "https://turbo.build/repo-schema",
  "tasks": {
    "wxt:prepare": {
      "outputs": [".wxt/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "wxt:prepare"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:chrome": {
      "dependsOn": ["^build"],
      "outputs": [".output/chrome-mv3/**"]
    },
    "build:firefox": {
      "dependsOn": ["^build"],
      "outputs": [".output/firefox-mv2/**", ".output/firefox-mv3/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:chrome": {
      "cache": false,
      "persistent": true
    },
    "dev:firefox": {
      "cache": false,
      "persistent": true
    },
    "zip:chrome": {
      "outputs": [".output/*-chrome.zip"]
    },
    "zip:firefox": {
      "outputs": [".output/*-firefox.zip"]
    }
  }
}
