{
  "name": "tamiz",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build build:chrome build:firefox",
    "dev": "turbo run dev dev:chrome dev:firefox",
    "format": "ultracite format",
    "lint": "ultracite check",
    "lint:fix": "ultracite check --write",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run --continue lint typecheck test",
    "zip": "turbo run zip:chrome zip:firefox"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "lefthook": "2.1.10",
    "turbo": "2.10.8",
    "ultracite": "7.10.0"
  },
  "packageManager": "bun@1.3.14"
}
