{
  "extends": ["ultracite/biome/core", "ultracite/biome/type-aware"],
  "linter": {
    "rules": {
      "correctness": {
        "noUnresolvedImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/radio-group.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
